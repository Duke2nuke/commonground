# Copy to .env (or export in your shell). Never commit a real key.
# Live mode: set this to your Qloo hackathon API key.
QLOO_API_KEY=
# Optional: override the API base. Default is the hackathon host.
# Fallback host documented in qloo_client.py: https://staging.api.qloo.com
QLOO_BASE_URL=https://hackathon.api.qloo.com
