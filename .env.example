# Copy to .env (or export in your shell). Never commit a real key.
# Live mode: set this to your event-issued Qloo hackathon API key.
# The app calls Qloo ONLY via the official hackathon kit harness:
#   npm install --global @qloo/qloo-harness   (Node 22.19+)
#   export QLOO_API_KEY="<key>"   (or: qloo setup --qloo)
QLOO_API_KEY=<redacted>
